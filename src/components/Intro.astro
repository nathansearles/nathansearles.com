---
import Email from "../components/Email.astro";
---

<section id="intro" class="section">
  <article class="section-wrapper">
    <h1>
      Hey, I&rsquo;m Nathan, a front-end developer and technical director.
    </h1>
    <div class="stack">
      <p>
        I&rsquo;ve spent my career working where design and technology meet. I
        lead projects, collaborate across disciplines, and balance technical
        leadership with hands-on development.
      </p>
      <p>
        Want to connect? Say hello at <Email />.
      </p>
    </div>
  </article>
</section>

<style>
  #intro {
    min-height: clamp(0px, 100vh, 960px);
  }

  h1 {
    max-width: 847px;
  }

  p {
    max-width: 847px;
  }
</style>
