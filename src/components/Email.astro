<button class="button" data-copy-email aria-describedby="copy-email-hint">
  <span aria-hidden="true" class="indicator" data-state="copy">
    <svg
      class="icon icon-copy"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      ><path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M22 5.25C22 3.45507 20.5449 2 18.75 2H11.25C9.45508 2 8 3.45507 8 5.25V8H5.25C3.45508 8 2 9.45507 2 11.25V18.75C2 20.5449 3.45507 22 5.25 22H12.75C14.5449 22 16 20.5449 16 18.75V16H18.75C20.5449 16 22 14.5449 22 12.75V5.25ZM16 14H18.75C19.4404 14 20 13.4404 20 12.75V5.25C20 4.55964 19.4404 4 18.75 4H11.25C10.5596 4 10 4.55964 10 5.25V8H12.75C14.5449 8 16 9.45507 16 11.25V14Z"
        fill="currentColor"></path></svg
    >
    <svg
      class="icon icon-check"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      ><path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2ZM15.774 10.1333C16.1237 9.70582 16.0607 9.0758 15.6332 8.72607C15.2058 8.37635 14.5758 8.43935 14.226 8.86679L10.4258 13.5116L9.20711 12.2929C8.81658 11.9024 8.18342 11.9024 7.79289 12.2929C7.40237 12.6834 7.40237 13.3166 7.79289 13.7071L9.79289 15.7071C9.99267 15.9069 10.2676 16.0129 10.5498 15.9988C10.832 15.9847 11.095 15.8519 11.274 15.6333L15.774 10.1333Z"
        fill="currentColor"></path></svg
    >
  </span>
  <span>nsearles@gmail.com</span>
</button>
<span id="copy-email-hint" class="visually-hidden">Copy to clipboard</span>
<span data-copy-status class="visually-hidden" aria-live="polite"></span>

<style>
  button {
    display: inline;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
    color: var(--color-text);
    padding-inline-start: 0.125rem;
    transition: color 150ms var(--ease-in-out-quad);
  }

  button:hover {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .indicator {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    margin-inline-end: 0.1875rem;
    transform: translateY(2px);
  }

  .icon {
    --icon-animation-duration: 0.3s;
    --icon-scale-min: 0.25;
    --icon-scale-max: 1;
    --icon-blur: 4px;
    --icon-ease: cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
    height: 100%;
    display: block;
    position: absolute;
    inset: 0;
    transition:
      opacity var(--icon-animation-duration) var(--icon-ease),
      transform var(--icon-animation-duration) var(--icon-ease),
      filter var(--icon-animation-duration) var(--icon-ease);
    will-change: opacity, transform, filter;
  }

  .indicator[data-state="copied"] .icon-copy {
    opacity: 0;
    transform: scale(var(--icon-scale-min));
    filter: blur(var(--icon-blur));
    pointer-events: none;
  }

  .icon-check {
    opacity: 0;
    transform: scale(var(--icon-scale-min));
    filter: blur(var(--icon-blur));
    pointer-events: none;
  }

  .indicator[data-state="copied"] .icon-check {
    opacity: 1;
    transform: scale(var(--icon-scale-max));
    filter: blur(0px);
    pointer-events: auto;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy-email]");

  if (button) {
    const indicator = button.querySelector<HTMLElement>(".indicator");
    const status = document.querySelector("[data-copy-status]");
    const email = button.dataset.email ?? button.textContent?.trim() ?? "";

    let resetTimer: number | undefined;

    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        return;
      }

      indicator?.setAttribute("data-state", "copied");
      if (status) status.textContent = "Copied";

      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        indicator?.setAttribute("data-state", "copy");
        if (status) status.textContent = "";
      }, 2000);
    });
  }
</script>
