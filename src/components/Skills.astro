---
import Card from "@/components/SkillCard.astro";
---

<section id="skills" class="section">
  <article class="section-wrapper">
    <h2>What I Do</h2>

    <div class="cards">
      <Card
        title="Build"
        description="Front-end development, responsive interfaces, modern web applications"
      />
      <Card
        title="Design"
        description="UI, interaction, motion, accessibility, design systems"
      />
      <Card
        title="Connect"
        description="CMS, APIs, backend services, content platforms"
      />
      <Card
        title="Shape"
        description="Components, patterns, tokens, scalable architectures"
      />
      <Card
        title="Optimize"
        description="Performance, accessibility, maintainability"
      />
      <Card
        title="Lead"
        description="Technical direction, project planning, team collaboration"
      />
      <Card
        title="Deliver"
        description="Scoping, client communication, QA, and launch"
      />
    </div>
  </article>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-column-gap: 1.25rem;
    grid-row-gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .cards {
      grid-template-columns: repeat(9, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .cards {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
  }
</style>
