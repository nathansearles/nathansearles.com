---
import { Font } from "astro:assets";
import Analytics from "@vercel/analytics/astro";

const {
  title = "Nathan Searles – Front-end Developer and Technical Director",
  description = "I’ve spent my career working where design and technology meet. I lead projects, collaborate across disciplines, and balance technical leadership with hands-on development.",
  image = "https://nathansearles.com/images/nathan-searles-og.jpg",
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://nathansearles.com",
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Nathan Searles" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Nathan Searles, Front-end Developer and Technical Director"
    />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <Font cssVariable="--font-allo" preload />
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>

<style is:global>
  :root {
    --font-body: var(--font-allo);
    --font-size-sm: 1rem;
    /* Clamp(min: 360px, max: 1440px) used for all calculations */
    /*16px to 19px */
    --font-size-base: clamp(1rem, 0.9375rem + 0.2778vw, 1.1875rem);
    /* 28px to 48px */
    --font-size-xl: clamp(1.75rem, 1.3333rem + 1.8519vw, 3rem);
    /* 46px to 74px */
    --font-size-2xl: clamp(2.875rem, 2.2917rem + 2.5926vw, 4.625rem);

    --color-black: oklch(0.21711 0.00251 248.17);
    --color-black-muted: oklch(0.238 0.00251 248.17);
    --color-white: oklch(0.949 0 0);
    --color-white-muted: oklch(0.615 0.00007 271.152);
    --color-neon-green: oklch(0.884 0.22 125.005);
    --color-orange: oklch(84.05% 0.11804 78.025);

    --color-background: var(--color-black);
    --color-text: var(--color-white);
    --color-text-secondary: var(--color-white-muted);
    --color-text-accent: var(--color-orange);
    --color-accent: var(--color-neon-green);
    --color-on-surface: var(--color-black-muted);
    --border-on-surface:
      inset 0 1px 0 oklch(0.268 0.00251 248.17),
      0 0 0 1px oklch(0.19 0.00251 248.17);

    --ease-in-out-quad: cubic-bezier(0.455, 0.03, 0.515, 0.955);

    --focus-outline-color: currentColor;
    --focus-outline-offset: 0.1rem;
    --focus-outline-style: solid;
    --focus-outline-width: 2px;
  }

  /* Reset  */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  *:not(dialog) {
    margin: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      interpolate-size: allow-keywords;
    }
  }

  body {
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  img,
  picture,
  video,
  canvas,
  svg {
    display: block;
    max-width: 100%;
  }

  input,
  button,
  textarea,
  select {
    font: inherit;
  }

  p,
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    overflow-wrap: break-word;
  }

  p {
    text-wrap: pretty;
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    text-wrap: balance;
  }

  *:focus-visible {
    outline-color: var(--focus-outline-color);
    outline-offset: var(--focus-outline-offset);
    outline-style: var(--focus-outline-style);
    outline-width: var(--focus-outline-width);
    border-radius: 0.25rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    *:focus-visible {
      animation: outline-bounce 0.5s;
    }
  }

  @keyframes outline-bounce {
    0% {
      outline-offset: var(--focus-outline-offset);
    }
    50% {
      outline-offset: calc(var(--focus-outline-offset) * 2);
    }
    100% {
      outline-offset: var(--focus-outline-offset);
    }
  }

  .visually-hidden {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-body);
    font-weight: 400;
    font-variation-settings: "ROND" 24;
    font-feature-settings: "zero", "liga";
  }

  h1 {
    color: var(--color-text);
    font-size: var(--font-size-2xl);
    line-height: 1.08;
    letter-spacing: 0em;
    font-weight: 550;
  }

  h2 {
    color: var(--color-text);
    font-size: var(--font-size-xl);
    line-height: 1.1;
    letter-spacing: 0.0125em;
    font-weight: 550;
  }

  h3 {
    color: var(--color-text);
    font-size: var(--font-size-base);
    line-height: 1.55;
    letter-spacing: 0.0125em;
    font-weight: 550;
  }

  h4 {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: 1.55;
    letter-spacing: 0.0125em;
    font-weight: 400;
  }

  p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: 1.55;
    letter-spacing: 0.0125em;
  }

  a:link,
  a:visited {
    color: var(--color-text);
    transition: color 150ms var(--ease-in-out-quad);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    text-decoration-color: currentColor;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-text-accent);
  }

  strong {
    font-weight: 400;
    color: var(--color-text);
  }

  .stack > * + * {
    margin-block-start: 1.5rem;
  }

  .section {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1440px;
  }

  .section-wrapper {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 0.8261rem + 5.2174vw, 5rem);
    padding-block: clamp(2rem, 0.8261rem + 5.2174vw, 5rem);
    padding-inline: clamp(2rem, 0.8261rem + 5.2174vw, 5rem);
  }
</style>
